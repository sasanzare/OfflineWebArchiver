{
  "name": "offline-web-archive-builder",
  "version": "0.8.0",
  "private": true,
  "description": "Production monorepo foundation for Offline Web Archive Builder",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node tools/build/build.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node tools/testing/run-tests.mjs all",
    "test:unit": "node tools/testing/run-tests.mjs unit",
    "test:integration": "node tools/testing/run-tests.mjs integration",
    "test:concurrency": "node tools/testing/run-tests.mjs concurrency",
    "test:process-kill": "node tools/testing/run-tests.mjs process-kill",
    "test:recovery": "node tools/testing/run-tests.mjs recovery",
    "test:phase17": "node tools/testing/run-tests.mjs phase17",
    "test:browser": "node tools/testing/run-tests.mjs browser",
    "test:rendering": "node tools/testing/run-tests.mjs rendering",
    "test:architecture": "node tools/architecture/validate.mjs",
    "test:electron": "node tools/testing/run-tests.mjs electron",
    "test:phase13:evidence": "node tools/testing/run-phase13-evidence.mjs run",
    "test:phase14:evidence": "node tools/testing/run-phase14-evidence.mjs",
    "test:phase14:evidence:validate": "node tools/testing/run-phase14-evidence.mjs validate",
    "test:phase15:evidence": "node tools/testing/run-phase15-evidence.mjs run",
    "test:phase15:evidence:validate": "node tools/testing/run-phase15-evidence.mjs validate",
    "test:phase13:evidence:baseline": "node tools/testing/run-phase13-evidence.mjs baseline",
    "test:phase13:evidence:validate": "node tools/testing/run-phase13-evidence.mjs validate",
    "test:phase13:evidence:reconcile": "node tools/testing/run-phase13-evidence.mjs reconcile",
    "test:cli": "node tools/testing/run-tests.mjs cli",
    "test:secrets": "node tools/testing/run-tests.mjs secrets",
    "test:secret-leakage": "node tools/testing/run-tests.mjs package:secrets",
    "test:okf": "node --experimental-strip-types --test --test-isolation=none tests/okf/validator.test.ts tests/okf/layered-validator.test.ts tests/okf/strict-validator.test.ts",
    "lint": "node tools/quality/lint.mjs",
    "format:check": "node tools/quality/format-check.mjs",
    "contracts:check": "node tools/contracts/check.mjs",
    "project-format:validate": "node tools/project-format/validate.mjs",
    "scope:validate": "node tools/scope/validate.mjs",
    "scope:golden": "node tools/scope/golden.mjs",
    "queue:validate": "node tools/queue/validate.mjs",
    "queue:state-machine": "node tools/queue/state-machine.mjs",
    "recovery:validate": "node tools/recovery/validate.mjs",
    "checkpoint:validate": "node tools/recovery/checkpoint-validate.mjs",
    "browser:install": "node tools/browser/provision.mjs install",
    "browser:verify": "node tools/browser/provision.mjs verify",
    "browser:info": "node tools/browser/provision.mjs info",
    "render:validate": "node tools/rendering/validate.mjs",
    "secret-store:validate": "node tools/secrets/validate.mjs",
    "vault:validate": "node tools/secrets/validate.mjs --vault",
    "diagnostics:validate": "node tools/secrets/validate.mjs --diagnostics",
    "migrations:validate": "node tools/migrations/validate.mjs",
    "okf:migrate": "node tools/okf/migrate.mjs",
    "okf:validate": "node tools/okf/cli.mjs validate",
    "okf:validate:conformance": "node tools/okf/cli.mjs validate --layer conformance",
    "okf:validate:official": "node tools/okf/cli.mjs validate --layer official",
    "okf:validate:references": "node tools/okf/cli.mjs validate --layer references",
    "okf:validate:provenance": "node tools/okf/cli.mjs validate --layer provenance",
    "okf:validate:extension": "node tools/okf/cli.mjs validate --layer extension",
    "okf:validate:extensions": "node tools/okf/cli.mjs validate --layer extension",
    "okf:validate:quality": "node tools/okf/cli.mjs validate --layer quality",
    "okf:validate:format": "node tools/okf/cli.mjs validate --layer format",
    "okf:validate:remote": "node tools/okf/cli.mjs validate --remote",
    "okf:validate:json": "node tools/okf/cli.mjs validate --format json",
    "docs:validate": "node tools/docs/validate.mjs",
    "security:check": "node tools/security/check.mjs",
    "clean": "node tools/build/clean.mjs",
    "dev:desktop": "npm run build && electron apps/desktop",
    "dev:cli": "npm run build && node apps/cli/dist/index.js --help",
    "project": "npm run build && node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "electron": "43.2.0",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "playwright-core": "1.56.1"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "esbuild@0.28.1": true
  }
}
