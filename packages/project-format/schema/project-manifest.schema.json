{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offline-web-archive.invalid/schema/project-manifest-1.0.0.json",
  "title": "Offline Web Archive Project Manifest",
  "description": "Documentation schema. Runtime authority is the strict Zod schema exported by @offline-web-archive/project-format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "application", "project", "source", "current", "database", "paths", "features", "lifecycle", "compatibility"],
  "properties": {
    "format": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "offline-web-archive-project" }, "version": { "const": "1.0.0" } } },
    "application": { "$ref": "#/$defs/versionObject" },
    "project": { "type": "object", "additionalProperties": false, "required": ["id", "name", "slug", "createdAt", "lastOpenedAt"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "createdAt": { "$ref": "#/$defs/timestamp" }, "lastOpenedAt": { "$ref": "#/$defs/timestamp" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["baseUrl"], "properties": { "baseUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https?://(?![^/?#]*@)" } } },
    "current": { "type": "object", "additionalProperties": false, "required": ["revisionId", "runId"], "properties": { "revisionId": { "$ref": "#/$defs/uuid" }, "runId": { "$ref": "#/$defs/uuid" } } },
    "database": { "type": "object", "additionalProperties": false, "required": ["path", "schemaVersion"], "properties": { "path": { "const": "database/crawl.db" }, "schemaVersion": { "const": 2 } } },
    "paths": { "type": "object", "additionalProperties": false, "required": ["pages", "assets", "apiResponses", "runtime", "reports", "logs"], "properties": { "pages": { "const": "pages" }, "assets": { "const": "assets" }, "apiResponses": { "const": "api/responses" }, "runtime": { "const": "runtime" }, "reports": { "const": "reports" }, "logs": { "const": "logs" } } },
    "features": { "type": "object", "additionalProperties": false, "required": ["scopePolicy", "crawlQueue", "browserRendering", "authentication", "proxies", "archiveGeneration"], "properties": { "scopePolicy": { "const": false }, "crawlQueue": { "const": false }, "browserRendering": { "const": false }, "authentication": { "const": false }, "proxies": { "const": false }, "archiveGeneration": { "const": false } } },
    "lifecycle": { "type": "object", "additionalProperties": false, "required": ["state", "lastValidatedAt"], "properties": { "state": { "enum": ["ready", "closed"] }, "lastValidatedAt": { "$ref": "#/$defs/timestamp" } } },
    "compatibility": { "type": "object", "additionalProperties": false, "required": ["minimumApplicationVersion"], "properties": { "minimumApplicationVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" } } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "versionObject": { "type": "object", "additionalProperties": false, "required": ["version"], "properties": { "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" } } }
  }
}
